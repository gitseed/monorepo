/// Rendered to compose config by scripts/up.bash via process substitution.
/// The proxied upstreams are shared from container/upstreams.yml — the single
/// source of truth also read by container/envoy.pkl and the tofu cert.
module compose

import "pkl:yaml"

local rawUpstreams =
  ((new yaml.Parser {}).parse(read("container/upstreams.yml").text) as Listing<Dynamic>).toList()

services {
  proxy {
    image = "credentials-proxy"
    build {
      context = "."
      dockerfile = "container/proxy.containerfile"
    }
    environment = rawUpstreams.map((u) -> u.env as String)
      + List("CREDENTIALS_PROXY_SERVER_CERT", "CREDENTIALS_PROXY_SERVER_KEY",
             "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY")
    healthcheck {
      // The envoy image has no curl.
      test = new Listing<String> { "CMD-SHELL"; "bash -c '</dev/tcp/127.0.0.1/443'" }
      interval = "1s"
      timeout = "2s"
      retries = 30
      start_period = "1s"
    }
  }
  dnsmasq {
    image = "dnsmasq"
    build {
      context = "./container"
      dockerfile = "dnsmasq.containerfile"
    }
    // *.amazonaws.com answers with the proxy's IP (discovered by
    // scripts/up.bash); everything else is inherited from the host's
    // resolver chain via the container's resolv.conf — 127.0.0.11,
    // Docker's embedded DNS, which forwards dnsmasq's own queries to the
    // daemon defaults (dnsmasq has no dns: set), so the chain can't loop.
    command = List(
      "--address=/amazonaws.com/${PROXY_IP}"
    )
    healthcheck {
      test = new Listing<String> { "CMD-SHELL"; "nslookup sts.amazonaws.com 127.0.0.1" }
      interval = "1s"
      timeout = "2s"
      retries = 10
      start_period = "1s"
    }
  }
  ["ai-sandbox"] {
    image = "ai-sandbox"
    build {
      context = "./container"
      dockerfile = "ai-sandbox.containerfile"
      secrets {
        "ca_cert"
      }
    }
    stdin_open = true
    tty = true
    // The bind (0.0.0.0:3080) comes from the profile patch layer
    // (container/dsh/cordis.patch.yml), not flags: the webserver schema
    // accepts only 127.0.0.1 or 0.0.0.0, loopback is unreachable through
    // the published port, and --host refuses 0.0.0.0 while the config
    // layer supports it. The browser-trust fence accepts loopback Host
    // headers natively, so no --trusted-host is needed.
    command = List("dsh", "web")
    ports = List("127.0.0.1:3080:3080")
    // Placeholders so tools think a credential is present and send an
    // Authorization header for the proxy to overwrite (dsh's OpenRouter
    // route, gh auth). AWS credentials are not in upstreams.yml (the
    // proxy signs via aws_request_signing), but the aws CLI and boto3
    // need dummy values or they refuse to send requests at all.
    environment = rawUpstreams.map((u) -> (u.env as String) + "=dummy-replaced-by-proxy")
      + List("AWS_ACCESS_KEY_ID=dummy-replaced-by-proxy",
             "AWS_SECRET_ACCESS_KEY=dummy-replaced-by-proxy",
             // The container is already the confinement boundary; dsh's
             // default ask-approval policy would stall an unattended
             // session.
             "DSH_PERMISSION_MODE=danger-full-access",
             // Never export session logs off-box (telemetry is default-
             // off upstream; this pins it).
             "DSH_TELEMETRY_DISABLED=1")
    // On a compose network the sandbox keeps Docker's embedded DNS
    // (127.0.0.11), which serves container names and link aliases itself
    // and forwards only external queries to this server -- so the links
    // below keep working while all external DNS flows through dnsmasq.
    // DNSMASQ_IP is discovered from the running container by scripts/up.bash.
    dns = "${DNSMASQ_IP}"
    depends_on {
      ["dnsmasq"] {
        condition = "service_healthy"
      }
    }
    secrets {
      "git_signing_key"
    }
    links = rawUpstreams.map((u) -> "proxy:" + (u.host as String))
    volumes {
      "${GIT_PROJECT_DIR:-..}:/workspace"
    }
    cap_drop {
      "NET_RAW"
      "NET_ADMIN"
    }
    security_opt {
      "no-new-privileges:true"
    }
  }
}

secrets {
  ca_cert {
    environment = "CREDENTIALS_PROXY_CA_CERT"
  }
  git_signing_key {
    environment = "GIT_SIGNING_KEY"
  }
}

output {
  renderer = new YamlRenderer {}
}
