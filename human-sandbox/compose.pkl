/// Rendered to compose config by scripts/up.bash via process substitution.
/// The env-var passthrough list lives in container/envs.yml.
module compose

import "pkl:yaml"

local rawEnvs =
  ((new yaml.Parser {}).parse(read("container/envs.yml").text) as Listing<String>).toList()

services {
  ["human-sandbox"] {
    image = "human-sandbox"
    build {
      context = "./container"
      dockerfile = "human-sandbox.containerfile"
    }
    stdin_open = true
    tty = true
    // Shown in the prompt (starship hostname module) to mark sandbox shells.
    hostname = "sandbox"
    // Bare names: compose copies each variable from its own environment,
    // which up.bash populates with real values via infisical run. The
    // sandbox occupant is a trusted human, so no credentials proxy and no
    // dummy placeholders — secrets are exposed directly.
    environment = rawEnvs
    volumes {
      "${GIT_PROJECT_DIR:-..}:/workspace"
    }
    cap_drop {
      "NET_RAW"
      "NET_ADMIN"
    }
    // No no-new-privileges (unlike ai-sandbox): the occupant runs as the
    // non-root "human" user and sudo is setuid, which that flag blocks.
  }
}

output {
  renderer = new YamlRenderer {}
}
