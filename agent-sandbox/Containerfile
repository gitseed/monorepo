ARG AGENT_VAULT_IMAGE=infisical/agent-vault:0.39.0
FROM ${AGENT_VAULT_IMAGE} AS agent-vault-upstream

# Agent Vault's published image declares /data as a persistent volume. This
# final stage deliberately does not: every vault database, CA, session, and
# cached secret disappears with the container.
FROM alpine:3.24.1 AS vault

RUN apk add --no-cache ca-certificates \
    && addgroup -S agentvault \
    && adduser -S -G agentvault -u 65532 agentvault \
    && mkdir -p /data/.agent-vault \
    && chown -R agentvault:agentvault /data

COPY --from=agent-vault-upstream /usr/local/bin/agent-vault /usr/local/bin/agent-vault
COPY services.yaml /etc/agent-vault/services.yaml

ENV HOME=/data
EXPOSE 14321 14322
USER agentvault
ENTRYPOINT ["/usr/local/bin/agent-vault"]
CMD ["server", "--host", "0.0.0.0", "--port", "14321"]

FROM oven/bun:1.3.14-debian AS agent

USER root

# The same core editing/search/browser tools used by the Lightning agent,
# without its AWS, Kubernetes, or nested-container credentials and machinery.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        chromium \
        curl \
        gh \
        git \
        jq \
        less \
        openssh-client \
        procps \
        python3 \
        python3-pip \
        ripgrep \
        fd-find \
        sqlite3 \
        unzip \
        vim-tiny \
        wget \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

RUN bun install --global @oh-my-pi/pi-coding-agent@17.1.6 \
    && omp --version

COPY --from=agent-vault-upstream /usr/local/bin/agent-vault /usr/local/bin/agent-vault
COPY scripts/entrypoint.bash /usr/local/bin/agent-sandbox-entrypoint

RUN chmod +x /usr/local/bin/agent-sandbox-entrypoint \
    && git config --global user.name "Agent Sandbox" \
    && git config --global user.email "agent@agent-sandbox.local"

ENV AGENT_VAULT_TELEMETRY=false
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/agent-sandbox-entrypoint"]
CMD []
