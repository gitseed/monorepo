/// Rendered to compose config by scripts/up.bash via process substitution.
/// The proxied upstreams are shared from container/upstreams.yml — the single
/// source of truth also read by container/envoy.pkl and the tofu cert.
module compose

import "pkl:yaml"

local rawUpstreams =
  ((new yaml.Parser {}).parse(read("container/upstreams.yml").text) as Listing<Dynamic>).toList()

services {
  proxy {
    image = "credentials-proxy"
    build {
      context = ".."
      dockerfile = "sandbox/container/proxy.containerfile"
    }
    environment = rawUpstreams.map((u) -> u.env as String)
      + List("CREDENTIALS_PROXY_SERVER_CERT", "CREDENTIALS_PROXY_SERVER_KEY",
             "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY")
    healthcheck {
      // The envoy image has no curl.
      test = new Listing<String> { "CMD-SHELL"; "bash -c '</dev/tcp/127.0.0.1/443'" }
      interval = "1s"
      timeout = "2s"
      retries = 30
      start_period = "1s"
    }
    networks {
      ["default"] {
        // Static so dnsmasq can answer *.amazonaws.com with it.
        // SANDBOX_* IPs are allocated per-session by scripts/up.bash.
        ipv4_address = "${SANDBOX_PROXY_IP}"
      }
    }
  }
  dnsmasq {
    image = "dnsmasq"
    build {
      context = ".."
      dockerfile = "sandbox/container/dnsmasq.containerfile"
    }
    // Wildcard *.amazonaws.com to the proxy; everything else goes to public
    // resolvers (dnsmasq ignores its own resolv.conf's 127.0.0.11 -- loopback).
    command = List(
      "--address=/amazonaws.com/${SANDBOX_PROXY_IP}",
      "--no-resolv",
      "--server=1.1.1.1",
      "--server=8.8.8.8"
    )
    healthcheck {
      test = new Listing<String> { "CMD-SHELL"; "nslookup sts.amazonaws.com 127.0.0.1" }
      interval = "1s"
      timeout = "2s"
      retries = 10
      start_period = "1s"
    }
    networks {
      ["default"] {
        // Static so the sandbox's dns: can reference it at create time.
        ipv4_address = "${SANDBOX_DNSMASQ_IP}"
      }
    }
  }
  sandbox {
    image = "sandbox"
    build {
      context = "./container"
      dockerfile = "sandbox.containerfile"
      secrets {
        "ca_cert"
      }
    }
    stdin_open = true
    tty = true
    // Placeholders so tools think a credential is present and send an
    // Authorization header for the proxy to overwrite (omp provider
    // availability, gh auth). AWS credentials are not in upstreams.yml
    // (the proxy signs via aws_request_signing), but the aws CLI needs
    // dummy values to send requests through the proxy.
    environment = rawUpstreams.map((u) -> (u.env as String) + "=dummy-replaced-by-proxy")
      + List("AWS_ACCESS_KEY_ID=dummy-replaced-by-proxy",
             "AWS_SECRET_ACCESS_KEY=dummy-replaced-by-proxy")
    // On a compose network the sandbox keeps Docker's embedded DNS
    // (127.0.0.11), which serves container names and link aliases itself and
    // forwards only external queries to this server -- so *.amazonaws.com
    // reaches dnsmasq (-> proxy) while the links below keep working.
    dns = "${SANDBOX_DNSMASQ_IP}"
    depends_on {
      ["dnsmasq"] {
        condition = "service_healthy"
      }
    }
    secrets {
      "git_signing_key"
    }
    links = rawUpstreams.map((u) -> "proxy:" + (u.host as String))
    volumes {
      "${GIT_PROJECT_DIR:-..}:/workspace"
      // Postgres unix socket from memory.compose.yml — the only path between
      // sandbox and the memory database (no shared network).
      "memory-socket:/var/run/postgresql"
    }
    cap_drop {
      "NET_RAW"
      "NET_ADMIN"
    }
    security_opt {
      "no-new-privileges:true"
    }
  }
}

secrets {
  ca_cert {
    environment = "CREDENTIALS_PROXY_CA_CERT"
  }
  git_signing_key {
    environment = "GIT_SIGNING_KEY"
  }
}

volumes {
  ["memory-socket"] {
    ["external"] = true
    name = "omp-memory-socket"
  }
}

networks {
  ["default"] {
    ["ipam"] {
      ["config"] = new Listing {
        new { ["subnet"] = "${SANDBOX_SUBNET}" }
      }
    }
  }
}

output {
  renderer = new YamlRenderer {}
}
