/// Rendered to envoy.yaml during the image build. The proxied upstreams
/// are shared from upstreams.yml — the single source of truth also read by
/// sandbox/compose.pkl and the tofu cert.
module envoy

import "pkl:yaml"

local class Upstream {
  /// The upstream we are credential injecting for.
  host: String
  /// Short name for the cluster, routes, and stats.
  name: String
  /// generic_secret name holding the injected credential.
  secret: String
  /// Environment variable the credential arrives in.
  env: String
  /// Authorization scheme prefix for the injected header.
  prefix: String = "Bearer "
}

local upstreams: List<Upstream> =
  ((new yaml.Parser {}).parse(read("upstreams.yml").text) as Listing<Dynamic>).toList()
    .map((d) -> new Upstream {
      host = d.host
      name = d.name
      secret = d.secret
      env = d.env
      prefix = if (d.hasProperty("prefix")) d.prefix as String else "Bearer "
    })

/// One cert covers every chain: it carries a SAN per proxied hostname.
local downstreamTls = new Dynamic {
  name = "envoy.transport_sockets.tls"
  typed_config {
    ["@type"] = "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext"
    common_tls_context {
      tls_certificates {
        new {
          certificate_chain { environment_variable = "CREDENTIALS_PROXY_SERVER_CERT" }
          private_key { environment_variable = "CREDENTIALS_PROXY_SERVER_KEY" }
        }
      }
    }
  }
}

/// TRACE/TRACK is bad news.
local traceTrackRefusal = new Dynamic {
  match {
    prefix = "/"
    headers {
      new {
        name = ":method"
        string_match { safe_regex { regex = "^(TRACE|TRACK)$" } }
      }
    }
  }
  direct_response {
    status = 405
    body { inline_string = "method not allowed\n" }
  }
}

local stdoutAccessLog = new Dynamic {
  name = "envoy.access_loggers.stdout"
  typed_config {
    ["@type"] = "type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog"
  }
}

local routerFilter = new Dynamic {
  name = "envoy.filters.http.router"
  typed_config {
    ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
  }
}

local function credentialInjector(u: Upstream): Dynamic = new Dynamic {
  name = "envoy.filters.http.credential_injector"
  typed_config {
    ["@type"] = "type.googleapis.com/envoy.extensions.filters.http.credential_injector.v3.CredentialInjector"
    overwrite = true
    credential {
      name = "envoy.http.injected_credentials.generic"
      typed_config {
        ["@type"] = "type.googleapis.com/envoy.extensions.http.injected_credentials.generic.v3.Generic"
        credential { name = u.secret }
        header = "Authorization"
        header_value_prefix = u.prefix
      }
    }
  }
}

/// Route and credential are selected together by SNI.
local function filterChain(u: Upstream): Dynamic = new Dynamic {
  filter_chain_match { server_names { u.host } }
  transport_socket = downstreamTls
  filters {
    new {
      name = "envoy.filters.network.http_connection_manager"
      typed_config {
        ["@type"] = "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager"
        stat_prefix = u.name
        route_config {
          name = u.name
          virtual_hosts {
            new {
              name = u.name
              domains { u.host }
              routes {
                traceTrackRefusal
                new {
                  match { prefix = "/" }
                  route {
                    cluster = u.name
                    host_rewrite_literal = u.host
                    // stream_idle_timeout still reaps hung connections.
                    timeout = "0s"
                  }
                }
              }
            }
          }
        }
        access_log { stdoutAccessLog }
        http_filters {
          credentialInjector(u)
          routerFilter
        }
      }
    }
  }
}

/// Strongly validate certificates.
local function cluster(u: Upstream): Dynamic = new Dynamic {
  name = u.name
  type = "LOGICAL_DNS"
  dns_lookup_family = "V4_ONLY"
  wait_for_warm_on_init = false
  typed_dns_resolver_config {
    name = "envoy.network.dns_resolver.getaddrinfo"
    typed_config {
      ["@type"] = "type.googleapis.com/envoy.extensions.network.dns_resolver.getaddrinfo.v3.GetAddrInfoDnsResolverConfig"
      num_retries = 1
    }
  }
  connect_timeout = "2s"
  load_assignment {
    cluster_name = u.name
    endpoints {
      new {
        lb_endpoints {
          new {
            endpoint {
              address {
                socket_address {
                  address = u.host
                  port_value = 443
                }
              }
            }
          }
        }
      }
    }
  }
  transport_socket {
    name = "envoy.transport_sockets.tls"
    typed_config {
      ["@type"] = "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext"
      sni = u.host
      common_tls_context {
        // Envoy's default curve list (X25519, P-256) rejects P-384 ECDSA
        // certs on TLS 1.2 upstreams (BoringSSL BAD_ECC_CERT) — context7's
        // AWS ELB is exactly that combination.
        tls_params {
          ecdh_curves {
            "X25519"
            "P-256"
            "P-384"
          }
        }
        validation_context {
          trusted_ca { filename = "/etc/ssl/certs/ca-certificates.crt" }
          match_typed_subject_alt_names {
            new {
              san_type = "DNS"
              matcher { exact = u.host }
            }
          }
        }
      }
    }
  }
}

static_resources {
secrets = upstreams.distinctBy((u) -> u.secret).map((u) -> new Dynamic {
  name = u.secret
  generic_secret { secret { environment_variable = u.env } }
})

  listeners {
    new {
      name = "upstream_https"
      address {
        socket_address {
          address = "0.0.0.0"
          port_value = 443
        }
      }
      // Required for SNI chain selection.
      listener_filters {
        new {
          name = "envoy.filters.listener.tls_inspector"
          typed_config {
            ["@type"] = "type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector"
          }
        }
      }
      filter_chains = upstreams.map((u) -> filterChain(u))
    }
  }

  clusters = upstreams.map((u) -> cluster(u))
}

output {
  renderer = new YamlRenderer {}
}
